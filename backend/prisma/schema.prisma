generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   // "ADMIN" | "DEPARTMENT_HEAD" | "TEACHER" | "STUDENT"
  createdAt    DateTime @default(now())
  isActive          Boolean @default(true)
  mustChangePassword Boolean @default(false)

  collegeId     String?
  college       College?     @relation("UserCollege", fields: [collegeId], references: [id])
  departmentId  String?
  department    Department?  @relation("UserDepartment", fields: [departmentId], references: [id])
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])
  semesterId    String?
  semester      Semester?    @relation(fields: [semesterId], references: [id])

  classesTaught     Class[]            @relation("TeacherClasses")
  enrollments       Enrollment[]
  attendanceRecords AttendanceRecord[]
  courseAssignments CourseAssignment[]
}

model College {
  id         String       @id @default(cuid())
  name       String       @unique
  departments Department[]
  users      User[]       @relation("UserCollege")
}

model Department {
  id        String   @id @default(cuid())
  name      String
  collegeId String
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  users     User[]   @relation("UserDepartment")
  courses   Course[]

  @@unique([collegeId, name])
}

model AcademicYear {
  id       String   @id @default(cuid())
  name     String   @unique
  sortOrder Int     @default(0)
  users    User[]
  courses  Course[]
}

model Semester {
  id       String   @id @default(cuid())
  name     String   @unique
  sortOrder Int     @default(0)
  users    User[]
  courses  Course[]
}

model Course {
  id             String   @id @default(cuid())
  name           String   @map("title")
  code           String   @unique
  departmentId   String
  department     Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  semesterId     String?
  semester       Semester? @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now())
  assignments    CourseAssignment[]
}

model CourseAssignment {
  id            String   @id @default(cuid())
  courseId      String
  teacherId     String
  assignedClass String?
  createdAt     DateTime @default(now())
  course        Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher       User   @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@unique([courseId, teacherId])
}

model Class {
  id        String   @id @default(cuid())
  name      String
  subject   String?
  teacherId String
  teacher   User     @relation("TeacherClasses", fields: [teacherId], references: [id])
  createdAt DateTime @default(now())

  enrollments Enrollment[]
  sessions    Session[]
}

model Enrollment {
  id        String @id @default(cuid())
  classId   String
  studentId String
  class     Class  @relation(fields: [classId], references: [id])
  student   User   @relation(fields: [studentId], references: [id])

  @@unique([classId, studentId])
}

model Session {
  id             String   @id @default(cuid())
  classId        String
  class          Class    @relation(fields: [classId], references: [id])
  code           String   @unique // short human-enterable code, e.g. "7K4P2Q"
  qrToken        String   @unique // long random token embedded in the QR payload
  opensAt        DateTime @default(now())
  closesAt       DateTime?
  gracePeriodSec Int      @default(300) // after this many seconds from opensAt, check-ins are marked LATE
  status         String   @default("OPEN") // "OPEN" | "CLOSED"
  latitude       Float?
  longitude      Float?
  radiusMeters   Int?
  createdAt      DateTime @default(now())
  lastSeenAt     DateTime @default(now())

  attendanceRecords AttendanceRecord[]
}

model AttendanceRecord {
  id          String    @id @default(cuid())
  sessionId   String
  session     Session   @relation(fields: [sessionId], references: [id])
  studentId   String
  student     User      @relation(fields: [studentId], references: [id])
  status      String    // "PRESENT" | "LATE" | "ABSENT" | "EXCUSED"
  checkedInAt DateTime?
  note        String?

  @@unique([sessionId, studentId])
}